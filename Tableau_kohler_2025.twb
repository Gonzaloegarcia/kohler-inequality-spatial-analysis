    <worksheet name='Agrupamiento por similitud'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>En Ur, las familias con casas de status similar vivían agrupadas en el mismo barrio</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
