            <groupfilter count='8' end='bottom' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='MIN([diferencia_gini_promedio])' function='order' user:ui-marker='order'>
