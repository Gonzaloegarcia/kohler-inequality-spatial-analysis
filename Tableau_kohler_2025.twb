              <calculation class='tableau' formula='CASE [region_grande]&#13;&#10;WHEN &quot;Sudamérica&quot; THEN &quot;Sudamérica&quot;&#13;&#10;ELSE &quot;Otras regiones&quot;&#13;&#10;END' />
