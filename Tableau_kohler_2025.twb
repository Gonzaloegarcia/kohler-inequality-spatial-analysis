              <calculation class='tableau' formula='CASE [nombre_sitio]&#13;&#10;WHEN &quot;Ur&quot; THEN &quot;Ur&quot;&#13;&#10;ELSE &quot;Otros sitios&quot;&#13;&#10;END' />
            </column>
            <column caption='Diferencia Gini Promedio' datatype='real' name='[diferencia_gini_promedio]' role='dimension' type='ordinal' />
